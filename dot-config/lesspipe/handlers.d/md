#!/usr/bin/env bash
# Pretty-print and syntax-highlight MD (Markdown).
#
# Matched by mime subtype (LESSPIPE_FTYPE=md) since Markdown files report
# application/md - the extension is not needed here.
#
# Requires: leaf

command -v leaf >/dev/null 2>&1 || exit 1   # not handled; fall through

# Force color when less can render it; leaf strips color into a pipe otherwise.
[[ "$LESSPIPE_COLOR" == always ]] && mdcolor=ansi || mdcolor=plain
leaf --inline $mdcolor "$1"
exit 0
